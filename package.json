{
  "name": "mytutor",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace mobile",
    "web": "npm run web --workspace mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs",
    "api": "npm run dev --workspace @mytutor/api",
    "migrate": "npm run migrate --workspace @mytutor/api"
  },
  "devDependencies": {
    "playwright-core": "^1.62.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "expo-notifications": "~57.0.7"
  }
}
