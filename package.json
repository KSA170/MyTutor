{
  "name": "mytutor",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace mobile",
    "web": "npm run web --workspace mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen-types": "supabase gen types typescript --linked > packages/shared/src/db-types.ts"
  }
}
