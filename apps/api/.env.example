# Copy to .env for local development (Render sets these via render.yaml)
DATABASE_URL=postgres://user:pass@localhost:5432/mytutor
JWT_SECRET=change-me-to-a-long-random-string
OPENROUTER_API_KEY=sk-or-v1-...
# Models are OpenRouter ids — swap freely. Defaults are cheap + strong:
TUTOR_MODEL=google/gemini-2.5-flash
UTILITY_MODEL=google/gemini-2.5-flash-lite
# Set WEB_SEARCH=0 to disable the :online web-search variant (saves credits)
UPLOAD_DIR=./data/uploads
PORT=3000
